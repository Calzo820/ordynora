DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
JWT_SECRET="genera-una-stringa-casuale-lunga-almeno-32-caratteri"
JWT_EXPIRES_IN="15m"
SESSION_DAYS="14"
STAFF_SESSION_DAYS="90"
CLIENT_URL="http://localhost:5173"
CORS_ORIGIN="http://localhost:5173,http://localhost:4173"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_CONNECT_WEBHOOK_SECRET=""
STRIPE_CONNECT_DEFAULT_COUNTRY="IT"
# Lascia false finché Stripe Connect e i pagamenti dal tavolo non sono pronti al rilascio.
PUBLIC_TABLE_PAYMENTS_ENABLED="false"

# Price ID Stripe Ordynora
# Puoi usare i nomi nuovi sotto oppure gli alias storici STARTER/GROWTH/ENTERPRISE.
STRIPE_PRICE_MONTHLY=""
STRIPE_PRICE_QUARTERLY=""
STRIPE_PRICE_SEMIANNUAL=""
STRIPE_PRICE_YEARLY=""

# Alias storici opzionali, mantenuti per compatibilità.
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_GROWTH=""
STRIPE_PRICE_ENTERPRISE=""

STRIPE_TRIAL_DAYS="14"
STRIPE_AUTOMATIC_TAX="false"
# STRIPE_WEBHOOK_ENDPOINT consigliato in Stripe/ngrok:
# https://TUO-NGROK.ngrok-free.dev/payments/webhook

# Email avviso accesso assistenza SuperAdmin tramite Brevo.
# Verifica il mittente in Brevo e copia la chiave API nelle variabili Render.
BREVO_API_KEY=""
MAIL_FROM_EMAIL="easy.menu.service@gmail.com"
MAIL_FROM_NAME="Ordynora"

# Traduzione automatica della landing e della demo in tutte le lingue supportate da Google Cloud Translation.
# Attiva Cloud Translation - Basic e inserisci una chiave API limitata a questa API.
GOOGLE_TRANSLATE_API_KEY=""

# Durata standard occupazione tavolo usata per evitare prenotazioni sovrapposte.
RESERVATION_SLOT_MINUTES="120"

MONITOR_WEBHOOK_URL=""
MONITOR_WEBHOOK_TOKEN=""
MONITOR_INTERVAL_MS="300000"

BACKUP_ENABLED="false"
BACKUP_ENCRYPTION_KEY=""
BACKUP_INTERVAL_HOURS="24"
BACKUP_RETENTION_DAYS="14"
BACKUP_DIR="./backups"
BACKUP_UPLOAD_URL=""
BACKUP_UPLOAD_TOKEN=""
BACKUP_KEEP_LOCAL="true"
