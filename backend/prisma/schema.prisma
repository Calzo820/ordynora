generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Restaurant {
  id                            String                  @id @default(cuid())
  name                          String
  slug                          String                  @unique
  primaryColor                  String?                 @default("#1d4ed8")
  logoUrl                       String?
  currency                      String                  @default("EUR")
  isActive                      Boolean                 @default(true)
  plan                          RestaurantPlan          @default(starter)
  operationMode                 RestaurantOperationMode @default(full)
  settingsJson                  Json?
  stripeCustomerId              String?                 @unique
  stripeConnectAccountId        String?                 @unique
  stripeConnectDetailsSubmitted Boolean                 @default(false)
  stripeConnectChargesEnabled   Boolean                 @default(false)
  stripeConnectPayoutsEnabled   Boolean                 @default(false)
  stripeConnectOnboardedAt      DateTime?
  subscription                  SaaSSubscription?
  createdAt                     DateTime                @default(now())
  updatedAt                     DateTime                @updatedAt

  users          User[]
  menuItems      MenuItem[]
  tables         Table[]
  orders         Order[]
  payments       PaymentTransaction[]
  tableSessions  TableSession[]
  reservations   Reservation[]
  errorLogs      ErrorLog[]
  orderCounter   OrderCounter?
  cashClosures   CashClosure[]
  auditLogs      AuditLog[]
  stockMovements StockMovement[]
  printJobs      PrintJob[]
  posIntegration PosIntegration?

  @@index([operationMode])
}

model User {
  id                         String    @id @default(cuid())
  restaurantId               String
  name                       String
  email                      String    @unique
  passwordHash               String
  emailVerifiedAt            DateTime?
  emailVerificationTokenHash String?   @unique
  emailVerificationExpiresAt DateTime?
  passwordResetTokenHash     String?   @unique
  passwordResetExpiresAt     DateTime?
  role                       UserRole  @default(owner)
  isActive                   Boolean   @default(true)
  pinHash                    String?
  pinEnabled                 Boolean   @default(false)
  isPinOnly                  Boolean   @default(false)
  lastLoginAt                DateTime?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  restaurant       Restaurant           @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  sessions         UserSession[]
  closedCashDays   CashClosure[]        @relation("CashClosureUser")
  auditLogs        AuditLog[]
  stockMovements   StockMovement[]
  createdPayments  PaymentTransaction[] @relation("PaymentCreatedBy")
  voidedItems      OrderItem[]          @relation("OrderItemVoidedBy")
  reopenedOrders   Order[]              @relation("OrderReopenedBy")
  claimedPrintJobs PrintJob[]           @relation("PrintJobClaimedBy")

  @@index([restaurantId, isActive, role])
}

model UserSession {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model MenuItem {
  id                String          @id @default(cuid())
  restaurantId      String
  name              String
  description       String?
  shortDescription  String?
  price             Decimal         @db.Decimal(10, 2)
  costPrice         Decimal         @default(0) @db.Decimal(10, 2)
  category          String?
  imageUrl          String?
  allergens         String[]        @default([])
  sku               String?
  vatRate           Decimal         @default(10) @db.Decimal(5, 2)
  sortOrder         Int             @default(0)
  isFeatured        Boolean         @default(false)
  preparationArea   PreparationArea
  isAvailable       Boolean         @default(true)
  isDeleted         Boolean         @default(false)
  trackStock        Boolean         @default(false)
  stockQuantity     Decimal         @default(0) @db.Decimal(10, 3)
  lowStockThreshold Decimal         @default(0) @db.Decimal(10, 3)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  restaurant     Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orderItems     OrderItem[]
  stockMovements StockMovement[]

  @@index([restaurantId, isDeleted, isAvailable, sortOrder])
  @@index([restaurantId, category, sortOrder])
}

model Table {
  id           String   @id @default(cuid())
  restaurantId String
  name         String
  code         String
  qrToken      String   @unique @default(cuid())
  seats        Int      @default(4)
  zone         String?
  sortOrder    Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant   Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orders       Order[]
  sessions     TableSession[]
  reservations Reservation[]

  @@unique([restaurantId, code])
  @@index([restaurantId, isActive, sortOrder])
}

model Reservation {
  id           String            @id @default(cuid())
  restaurantId String
  tableId      String?
  customerName String
  phone        String?
  date         DateTime
  time         String
  guests       Int               @default(2)
  notes        String?
  status       ReservationStatus @default(booked)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  table      Table?     @relation(fields: [tableId], references: [id], onDelete: SetNull)

  @@index([restaurantId, date])
  @@index([restaurantId, status, date])
  @@index([tableId, date])
  @@index([status])
}

model TableSession {
  id                        String             @id @default(cuid())
  restaurantId              String
  tableId                   String
  status                    TableSessionStatus @default(open)
  guestName                 String?
  notes                     String?
  totalAmount               Decimal            @default(0) @db.Decimal(10, 2)
  integrationRevision       Int                @default(0)
  integrationSyncedRevision Int                @default(0)
  integrationSyncStatus     String             @default("not_required")
  integrationLastError      String?
  integrationSyncedAt       DateTime?
  openedAt                  DateTime           @default(now())
  closedAt                  DateTime?
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  table      Table      @relation(fields: [tableId], references: [id], onDelete: Restrict)
  orders     Order[]

  @@index([restaurantId, status, openedAt])
  @@index([restaurantId, integrationSyncStatus, updatedAt])
  @@index([tableId, status, openedAt])
}

model Order {
  id                  String           @id @default(cuid())
  restaurantId        String
  tableId             String
  tableSessionId      String?
  publicToken         String           @unique @default(cuid())
  orderNumber         Int              @default(1)
  customerName        String?
  notes               String?
  source              OrderSource      @default(qr)
  status              OrderStatus      @default(pending)
  paymentStatus       PaymentStatus    @default(unpaid)
  paymentMethod       PaymentMethod?
  clientRequestId     String?
  idempotencyKey      String?          @unique
  totalAmount         Decimal          @default(0) @db.Decimal(10, 2)
  discountAmount      Decimal          @default(0) @db.Decimal(10, 2)
  discountPercent     Decimal          @default(0) @db.Decimal(5, 2)
  extraAmount         Decimal          @default(0) @db.Decimal(10, 2)
  guestCount          Int              @default(1)
  coverCharge         Decimal          @default(0) @db.Decimal(10, 2)
  coverChargePerGuest Boolean          @default(true)
  equalSplitEnabled   Boolean          @default(true)
  billConfiguredAt    DateTime?
  billRequestedAt     DateTime?
  billRevision        Int              @default(1)
  settlementSource    SettlementSource @default(ordynora)
  integrationRevision       Int      @default(0)
  integrationSyncedRevision Int      @default(0)
  integrationSyncStatus     String   @default("not_required")
  integrationLastError      String?
  integrationSyncedAt       DateTime?
  acceptedAt          DateTime?
  readyAt             DateTime?
  servedAt            DateTime?
  closedAt            DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  restaurant    Restaurant           @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  table         Table                @relation(fields: [tableId], references: [id], onDelete: Restrict)
  tableSession  TableSession?        @relation(fields: [tableSessionId], references: [id], onDelete: SetNull)
  items         OrderItem[]
  statusHistory OrderStatusHistory[]
  payments      PaymentTransaction[]
  printJobs     PrintJob[]

  stripeCheckoutSessionId String?
  stripePaymentIntentId   String?
  paidAt                  DateTime?
  reopenedAt              DateTime?
  reopenedByUserId        String?

  reopenedBy User? @relation("OrderReopenedBy", fields: [reopenedByUserId], references: [id], onDelete: SetNull)

  @@index([restaurantId, createdAt])
  @@index([restaurantId, status, closedAt, createdAt])
  @@index([restaurantId, paymentStatus, createdAt])
  @@index([restaurantId, settlementSource, closedAt])
  @@index([restaurantId, integrationSyncStatus, updatedAt])
  @@index([tableId, closedAt, status, createdAt])
  @@index([tableSessionId, status])
}

model OrderItem {
  id                   String            @id @default(cuid())
  orderId              String
  menuItemId           String?
  quantity             Int
  nameSnapshot         String
  priceSnapshot        Decimal           @db.Decimal(10, 2)
  costSnapshot         Decimal           @default(0) @db.Decimal(10, 2)
  categorySnapshot     String?
  notes                String?
  preparationArea      PreparationArea?
  preparationStatus    PreparationStatus @default(pending)
  courseNumber         Int               @default(1)
  releasedAt           DateTime?
  preparationStartedAt DateTime?
  preparationReadyAt   DateTime?
  status               OrderItemStatus   @default(active)
  voidReason           String?
  voidedAt             DateTime?
  voidedByUserId       String?
  isComplimentary      Boolean           @default(false)
  complimentaryReason  String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  order    Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  voidedBy User?     @relation("OrderItemVoidedBy", fields: [voidedByUserId], references: [id], onDelete: SetNull)

  @@index([orderId, status, preparationArea, preparationStatus])
  @@index([orderId, status, courseNumber, releasedAt])
  @@index([preparationArea, preparationReadyAt])
  @@index([menuItemId, createdAt])
}

model PaymentTransaction {
  id                      String         @id @default(cuid())
  restaurantId            String
  orderId                 String
  provider                String         @default("stripe")
  providerSessionId       String?        @unique
  providerPaymentIntentId String?
  connectedAccountId      String?
  amount                  Decimal        @db.Decimal(10, 2)
  currency                String         @default("EUR")
  status                  PaymentStatus  @default(pending)
  method                  PaymentMethod?
  splitLabel              String?
  splitKey                String?        @unique
  splitIndex              Int?
  splitCount              Int?
  coversCount             Int            @default(0)
  billRevision            Int?
  checkoutExpiresAt       DateTime?
  createdByUserId         String?
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
  paidAt                  DateTime?

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  order      Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdBy  User?      @relation("PaymentCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([orderId, status, createdAt])
  @@index([restaurantId, status, createdAt])
}

model CashClosure {
  id             String            @id @default(cuid())
  restaurantId   String
  businessDate   DateTime
  grossTotal     Decimal           @default(0) @db.Decimal(10, 2)
  expectedCash   Decimal           @default(0) @db.Decimal(10, 2)
  declaredCash   Decimal           @default(0) @db.Decimal(10, 2)
  difference     Decimal           @default(0) @db.Decimal(10, 2)
  cardTotal      Decimal           @default(0) @db.Decimal(10, 2)
  onlineTotal    Decimal           @default(0) @db.Decimal(10, 2)
  otherTotal     Decimal           @default(0) @db.Decimal(10, 2)
  orderCount     Int               @default(0)
  paymentCount   Int               @default(0)
  notes          String?
  status         CashClosureStatus @default(closed)
  closedByUserId String?
  closedAt       DateTime          @default(now())
  reopenedAt     DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  closedBy   User?      @relation("CashClosureUser", fields: [closedByUserId], references: [id], onDelete: SetNull)

  @@unique([restaurantId, businessDate])
  @@index([restaurantId, businessDate])
}

model AuditLog {
  id           String   @id @default(cuid())
  restaurantId String
  userId       String?
  action       String
  entityType   String
  entityId     String?
  reason       String?
  metadata     Json?
  ipAddress    String?
  createdAt    DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  user       User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([restaurantId, createdAt])
  @@index([entityType, entityId])
}

model StockMovement {
  id             String            @id @default(cuid())
  restaurantId   String
  menuItemId     String
  userId         String?
  orderItemId    String?
  type           StockMovementType
  quantityBefore Decimal           @db.Decimal(10, 3)
  quantityChange Decimal           @db.Decimal(10, 3)
  quantityAfter  Decimal           @db.Decimal(10, 3)
  reason         String?
  createdAt      DateTime          @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  menuItem   MenuItem   @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  user       User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([restaurantId, createdAt])
  @@index([menuItemId, createdAt])
}

model PrintJob {
  id              String          @id @default(cuid())
  restaurantId    String
  orderId         String
  area            PreparationArea
  eventKey        String          @unique
  kind            String          @default("order")
  status          PrintJobStatus  @default(pending)
  attempts        Int             @default(0)
  lastError       String?
  claimedByUserId String?
  claimedAt       DateTime?
  printedAt       DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  order      Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  claimedBy  User?      @relation("PrintJobClaimedBy", fields: [claimedByUserId], references: [id], onDelete: SetNull)

  @@index([restaurantId, area, status, createdAt])
  @@index([orderId, createdAt])
}

model PosIntegration {
  id                   String               @id @default(cuid())
  restaurantId         String               @unique
  provider             PosProvider
  status               PosIntegrationStatus @default(draft)
  encryptedCredentials String?
  credentialKeyVersion Int                  @default(1)
  config               Json?
  lastTestedAt         DateTime?
  lastSyncAt           DateTime?
  lastError            String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  restaurant Restaurant              @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  mappings   PosIntegrationMapping[]
  jobs       PosIntegrationJob[]

  @@index([provider, status])
}

model PosIntegrationMapping {
  id            String   @id @default(cuid())
  integrationId String
  entityType    String
  localId       String
  externalId    String
  metadata      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  integration PosIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([integrationId, entityType, localId])
  @@unique([integrationId, entityType, externalId])
  @@index([integrationId, entityType])
}

model PosIntegrationJob {
  // One processing job per entity is enforced by the partial unique index
  // in 20261106120000_integration_exclusive_jobs (Prisma 5 cannot express it).
  id             String               @id @default(cuid())
  integrationId  String
  operation      String
  direction      IntegrationDirection @default(outbound)
  status         IntegrationJobStatus @default(pending)
  idempotencyKey String               @unique
  entityType     String?
  entityId       String?
  externalId     String?
  payload        Json?
  responseMeta   Json?
  attempts       Int                  @default(0)
  nextAttemptAt  DateTime?
  lockedAt       DateTime?
  lockToken      String?
  processedAt    DateTime?
  lastError      String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  integration PosIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@index([integrationId, status, nextAttemptAt])
  @@index([entityType, entityId])
  @@index([status, lockedAt])
}

model OrderStatusHistory {
  id              String       @id @default(cuid())
  orderId         String
  fromStatus      OrderStatus?
  toStatus        OrderStatus
  changedByUserId String?
  changedByRole   String?
  note            String?
  createdAt       DateTime     @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

model SaaSSubscription {
  id                   String             @id @default(cuid())
  restaurantId         String             @unique
  stripeCustomerId     String?
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  plan                 RestaurantPlan     @default(starter)
  status               SubscriptionStatus @default(trialing)
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  trialEndsAt          DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([status, currentPeriodEnd])
}

model OrderCounter {
  restaurantId String   @id
  nextNumber   Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
}

enum RestaurantPlan {
  starter
  growth
  semiannual
  enterprise
}

enum RestaurantOperationMode {
  full
  integrated
}

enum SettlementSource {
  ordynora
  external_pos
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  canceled
  unpaid
  incomplete
}

enum UserRole {
  owner
  admin
  kitchen
  bar
  cashier
  waiter
}

enum PreparationArea {
  kitchen
  bar
}

enum PreparationStatus {
  pending
  in_progress
  ready
  served
}

enum OrderStatus {
  pending
  in_progress
  ready
  served
  cancelled
}

enum TableSessionStatus {
  open
  closing
  closed
}

enum ReservationStatus {
  booked
  seated
  cancelled
  no_show
}

enum OrderSource {
  qr
  staff
  delivery
}

enum PaymentStatus {
  unpaid
  pending
  paid
  refunded
}

enum PaymentMethod {
  cash
  card
  online
  satispay
  other
}

enum OrderItemStatus {
  active
  voided
}

enum CashClosureStatus {
  closed
  reopened
}

enum StockMovementType {
  adjustment
  sale
  restock
  waste
  restore
}

enum PrintJobStatus {
  pending
  processing
  printed
  failed
}

enum PosProvider {
  tilby
  teamsystem_cassa_in_cloud
  passepartout_menu
}

enum PosIntegrationStatus {
  draft
  pending_partner
  testing
  connected
  degraded
  disabled
}

enum IntegrationDirection {
  inbound
  outbound
}

enum IntegrationJobStatus {
  pending
  processing
  retrying
  succeeded
  failed
  blocked
}

model ErrorLog {
  id           String    @id @default(cuid())
  restaurantId String?
  level        String    @default("error")
  source       String
  message      String
  stack        String?
  metadata     Json?
  resolvedAt   DateTime?
  createdAt    DateTime  @default(now())

  restaurant Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: SetNull)

  @@index([restaurantId, createdAt])
  @@index([restaurantId, resolvedAt, createdAt])
  @@index([level, createdAt])
}
